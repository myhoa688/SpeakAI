# ╔═══════════════════════════════════════════════════════╗
# ║          SpeakAI — Backend Environment Example        ║
# ╚═══════════════════════════════════════════════════════╝
# Copy file này thành .env rồi điền giá trị thực tế.

# ── Server ──────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# ── Database ─────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/speakai
MONGO_URI_FALLBACK=mongodb://127.0.0.1:27017/speakai

# ── Auth ─────────────────────────────────────────────────
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ── AI — GROQ ────────────────────────────────────────────
# Lấy API key tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# ── Email / SMTP ─────────────────────────────────────────
# Nếu để trống SMTP_USER hoặc SMTP_PASS → DEV OTP MODE
# OTP sẽ hiện trong console log và trả về trong response (debugCode)
#
# Để gửi email thật qua Gmail:
# 1. Vào https://myaccount.google.com/apppasswords
# 2. Tạo "App Password" cho "Mail" → sao chép 16 ký tự
# 3. Điền vào SMTP_USER (email Gmail) và SMTP_PASS (16 ký tự app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=SpeakAI <no-reply@speakai.local>

# ── App ──────────────────────────────────────────────────
APP_URL=http://localhost:5173
ADMIN_EMAIL=admin@speakai.local
ADMIN_PASSWORD=Admin@123
